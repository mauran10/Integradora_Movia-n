@page
@model Integradora_Movia.Pages.RegistroModel
@{
    // Usa tu layout de registro aquís
    Layout = "_LoginLayout";
    ViewData["Title"] = "Registro de Usuario";
}

<!-- INCLUSIÓN DE FONT AWESOME PARA ICONOS -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLMD/CDQ+bIOW0iXwX3JjJ0/yU/z4p2A2qD9gq4B5eR2fG0Q0h/x6+4r5O2T/rA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

<div class="form-container-registro">

    <div class="form-box-login large-form">

        <h2>Registro de Usuario</h2>

        <form method="post">

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    @Model.ErrorMessage
                </div>
            }

            <!-- Muestra errores generales de validación, si los hay. -->
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- INICIO DE LA CUADRÍCULA (2 COLUMNAS) -->
            <div class="registro-grid">

                <!-- Nombres -->
                <div class="form-group">
                    <input asp-for="Input.Nombres" placeholder="Nombres" class="form-control-movia" />
                    <span asp-validation-for="Input.Nombres" class="text-danger"></span>
                </div>

                <!-- Apellidos -->
                <div class="form-group">
                    <input asp-for="Input.Apellidos" placeholder="Apellidos" class="form-control-movia" />
                    <span asp-validation-for="Input.Apellidos" class="text-danger"></span>
                </div>

                <!-- Edad -->
                <div class="form-group">
                    <input type="number" asp-for="Input.Edad" placeholder="Edad" class="form-control-movia" />
                    <span asp-validation-for="Input.Edad" class="text-danger"></span>
                </div>

                <!-- Municipio de Residencia -->
                <div class="form-group">
                    <input asp-for="Input.Municipio" placeholder="Municipio de Residencia" class="form-control-movia" />
                    <span asp-validation-for="Input.Municipio" class="text-danger"></span>
                </div>

        
            <!-- Nombre de Usuario -->
            <div class="form-group">
                <input asp-for="Input.UsuarioNombre" placeholder="Nombre de Usuario" class="form-control-movia" />
                <span asp-validation-for="Input.UsuarioNombre" class="text-danger"></span>
            </div>

            <!-- Correo Electrónico -->
            <div class="form-group">
                <input type="email" asp-for="Input.CorreoElectronico" placeholder="Correo Electrónico" class="form-control-movia" />
                <span asp-validation-for="Input.CorreoElectronico" class="text-danger"></span>
            </div>

            <!-- Contraseña -->
            <div class="form-group">
                <input type="password" asp-for="Input.Contrasena" placeholder="Contraseña" class="form-control-movia" />
                <span asp-validation-for="Input.Contrasena" class="text-danger"></span>
            </div>

            <!-- Confirmar Contraseña -->
            <div class="form-group">
                <input type="password" asp-for="Input.ConfirmarContrasena" placeholder="Confirmar Contraseña" class="form-control-movia" />
                <span asp-validation-for="Input.ConfirmarContrasena" class="text-danger"></span>
                </div>
            </div>
            <!-- FIN DE LA CUADRÍCULA -->

            <!-- Botón de Registro -->
            <button type="submit" class="btn btn-primary-movia full-width-btn">Registrarse</button>
        </form>

        <div class="mt-3">
            <p>¿Ya tienes una cuenta? <a asp-page="/Login" class="login-link">Inicia Sesión</a></p>
        </div>
    </div>
</div>

<!-- FOOTER COMPLETO CON ICONOS REALES -->
<footer class="login-footer">
    <div class="footer-content">
        <div class="copyright-info">
            <p>&copy; 2025 - Integradora - <a asp-area="" asp-page="/Privacy">Política de Privacidad</a></p>
        </div>
        <div class="social-links">
            <!-- Icono de Facebook -->
            <a href="#" class="social-icon" title="Facebook">
                <i class="fab fa-facebook-f"></i>
            </a>
            <!-- Icono de Twitter / X -->
            <a href="#" class="social-icon" title="Twitter / X">
                <i class="fab fa-twitter"></i>
            </a>
            <!-- Icono de Instagram -->
            <a href="#" class="social-icon" title="Instagram">
                <i class="fab fa-instagram"></i>
            </a>
        </div>
    </div>
</footer>


@section Scripts {
    <!-- Esta línea es CRUCIAL para la validación de JavaScript en el lado del cliente -->
    <partial name="_ValidationScriptsPartial" />
}