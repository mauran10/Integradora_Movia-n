@page "{id:int}"
@model Integradora_Movia.Pages.Admin.EditarConductorModel

@{
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" />
}

@section CustomHeader {
    <header>
        <nav class="navbar">
            <div class="container-fluid d-flex justify-content-between align-items-center">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <img src="~/images/movia_logo.png" alt="MOVIA Logo" class="logo">
                </a>

            </div>
        </nav>
    </header>
}

<h3> Editar Conductor: @Model.Conductor.Nombres @Model.Conductor.Apellidos</h3>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="Conductor.IdConductor" />
    <input type="hidden" asp-for="Conductor.FechaRegistro" />
    <input type="hidden" asp-for="Conductor.Contrasena" />

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label asp-for="Conductor.Nombres"></label>
                <input asp-for="Conductor.Nombres" class="form-control" />
                <span asp-validation-for="Conductor.Nombres" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Conductor.Apellidos"></label>
                <input asp-for="Conductor.Apellidos" class="form-control" />
                <span asp-validation-for="Conductor.Apellidos" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Conductor.Curp"></label>
                <input asp-for="Conductor.Curp" class="form-control" />
                <span asp-validation-for="Conductor.Curp" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Conductor.NumeroTelefono"></label>
                <input asp-for="Conductor.NumeroTelefono" class="form-control" />
                <span asp-validation-for="Conductor.NumeroTelefono" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label asp-for="Conductor.CorreoElectronico"></label>
                <input asp-for="Conductor.CorreoElectronico" class="form-control" />
                <span asp-validation-for="Conductor.CorreoElectronico" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Conductor.NumeroLicencia"></label>
                <input asp-for="Conductor.NumeroLicencia" class="form-control" />
                <span asp-validation-for="Conductor.NumeroLicencia" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Conductor.Vencimiento">Vencimiento Licencia</label>
                <input type="date" asp-for="Conductor.Vencimiento" class="form-control" />
                <span asp-validation-for="Conductor.Vencimiento" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Conductor.TipoLicencia"></label>
                <input asp-for="Conductor.TipoLicencia" class="form-control" />
                <span asp-validation-for="Conductor.TipoLicencia" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-success"> Guardar Cambios</button>
        <a asp-page="Conductores" class="btn btn-secondary">Cancelar</a>
    </div>
</form>